# Copie para .env.local e preencha. NUNCA versione o .env.local.
# Só os NOMES das variáveis ficam aqui; valores nunca vão para o repositório.
# Sem nenhuma delas o sistema sobe em modo demo (dados fictícios, sem login).

# --- Google Maps (empresas reais) ---------------------------------------------
# node scripts/set-google-key.mjs grava sem expor a chave.
GOOGLE_PLACES_API_KEY=

# --- Supabase (persistência e login) ------------------------------------------
# node scripts/set-supabase.mjs pede e grava; node scripts/verificar-supabase.mjs confere.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- IA -------------------------------------------------------------------------
# Opcional. Sem chave, a análise e as mensagens usam o motor determinístico.
OPENAI_API_KEY=
OPENAI_MODEL=
# node scripts/set-anthropic-key.mjs grava sem expor a chave. Com ela, o Vendedor usa o
# modelo para classificar as respostas dos leads (só escolhe uma categoria; o resto é
# código) e as mensagens de abordagem passam a ser escritas por ele. Tem prioridade
# sobre a OpenAI. Sem nenhuma chave, tudo roda no motor determinístico.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Avaliação visual do site (opcional, Agente 3): modelo com visão e navegador para as capturas.
# Sem CHROME_PATH, procura o Chrome e o Edge nos locais comuns.
ANTHROPIC_VISION_MODEL=
CHROME_PATH=
# Prévia de site (Agente 5): pasta dos arquivos (padrão .data/site-previews) e, se houver um túnel seu,
# o endereço público do CRM, usado para mandar o link da prévia no aviso ao seu WhatsApp.
SITE_PREVIEW_DIR=
PUBLIC_BASE_URL=

# --- Instagram (Agente 7) -------------------------------------------------------
# Conta Instagram Business ligada a uma página do Facebook + token de longa duração da API Graph.
# node scripts/set-instagram-token.mjs grava os dois sem expor o token. Sem eles o agente propõe posts,
# mas o botão "Aprovar e publicar" fica desligado.
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_VERSION=

# --- Agentes (AgentOS) ----------------------------------------------------------
# O runner dos agentes sobe junto com o servidor (npm run build && npm start).
# "off" desliga o runner (o dashboard continua funcionando). Na Vercel ele nunca roda.
AGENTS_RUNNER=

# --- WhatsApp (gateway por QR Code) ---------------------------------------------
# node scripts/set-whatsapp-gateway.mjs gera os três valores e grava os mesmos no
# .env.gateway do gateway, sem exibi-los. Ver docs/WHATSAPP_LOCAL.md.
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
# Opcional; o padrão é o id da organização.
WHATSAPP_SESSION_ID=

# --- Carreira / e-mail ----------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
CRON_SECRET=
CAREER_TOKEN_SECRET=
CAREER_WORKER_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
OCR_SPACE_API_KEY=
CAREER_DEMO_JOBS=
