# Variáveis do processo do gateway de WhatsApp (npm run gateway). NUNCA versione o .env.gateway.
# O jeito normal de preenchê-lo é:  node scripts/set-whatsapp-gateway.mjs
# (gera token e segredo aleatórios e grava os mesmos valores no .env.local do CRM, sem exibi-los).

# Token que o CRM usa para falar com o gateway (>= 16 caracteres).
WHATSAPP_GATEWAY_TOKEN=

# Segredo que assina os eventos entregues ao CRM (>= 16 caracteres); o CRM usa o mesmo valor.
WHATSAPP_WEBHOOK_SECRET=

# Para onde entregar os eventos. Sem isto eles ficam retidos na caixa de saída (nada se perde).
CRM_WEBHOOK_URL=http://127.0.0.1:3000/api/webhooks/whatsapp

# Porta e endereço do gateway. Só local: nunca exponha sem HTTPS na frente.
GATEWAY_PORT=3200
GATEWAY_HOST=127.0.0.1

# 1 = modo de teste: conecta de verdade, mas NÃO envia nada pelo WhatsApp. É o padrão.
# O envio real só existirá junto com a política de envio; até lá, 0 não libera nada.
WHATSAPP_GATEWAY_DRY_RUN=1

# Entrega as mensagens recebidas ao CRM. Deixe 0 até a fase do Vendedor tratá-las.
GATEWAY_FORWARD_MESSAGES=0

# Arquivo SQLite com a sessão do WhatsApp e a caixa de saída (padrão: gateway/.data/gateway.db).
# Copiá-lo é o backup; perdê-lo exige ler o QR Code de novo.
# GATEWAY_DB_FILE=

# Tempo máximo esperando a leitura do QR Code (ms) e log do Baileys (silent|info|debug).
# GATEWAY_QR_WAIT_MAX_MS=300000
# BAILEYS_LOG_LEVEL=silent
